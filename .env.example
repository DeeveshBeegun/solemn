NODE_ENV=development
LOG_LEVEL=info

# Local development credentials only. Compose reads these values too.
POSTGRES_USER=solemn
POSTGRES_PASSWORD=solemn_local_password
POSTGRES_DB=solemn
POSTGRES_PORT=5432
TEST_POSTGRES_PASSWORD=solemn_test_local_password

DATABASE_URL=postgresql://solemn:solemn_local_password@localhost:5432/solemn
TEST_DATABASE_URL=postgresql://solemn_test:solemn_test_local_password@localhost:5433/solemn_test

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
INITIAL_PAPER_BALANCE_USD=100
