NODE_ENV=development
LOG_LEVEL=info

# Local development credentials only. Compose reads these values too.
POSTGRES_USER=solemn
POSTGRES_PASSWORD=solemn_local_password
POSTGRES_DB=solemn
POSTGRES_PORT=5432
TEST_POSTGRES_PASSWORD=solemn_test_local_password

DATABASE_URL=postgresql://solemn:solemn_local_password@localhost:5432/solemn
TEST_DATABASE_URL=postgresql://solemn_test:solemn_test_local_password@localhost:5433/solemn_test

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
INITIAL_PAPER_BALANCE_USD=100

# Read-only discovery; opt in explicitly. These two subscriptions are free.
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=
SCANNER_ENABLED=false
SCANNER_SUBSCRIBE_NEW_TOKENS=true
SCANNER_SUBSCRIBE_MIGRATIONS=true
SCANNER_RECONNECT_INITIAL_MS=1000
SCANNER_RECONNECT_MAX_MS=30000
# 0 means unlimited, bounded-backoff reconnect attempts.
SCANNER_RECONNECT_MAX_ATTEMPTS=0
SCANNER_STABLE_CONNECTION_MS=30000
SCANNER_CONNECT_TIMEOUT_MS=10000
SCANNER_HEARTBEAT_INTERVAL_MS=30000
SCANNER_HEARTBEAT_TIMEOUT_MS=10000
SCANNER_QUEUE_CAPACITY=1000
SCANNER_DB_MAX_ATTEMPTS=3
SCANNER_DB_RETRY_MS=250
SCANNER_DRAIN_TIMEOUT_MS=20000
SCANNER_METRICS_INTERVAL_MS=30000
SCANNER_MAX_MESSAGE_BYTES=65536

# Read-only risk analysis: enable explicitly after applying Week 3 migrations.
TOKEN_RISK_ANALYSIS_ENABLED=false
JUPITER_TOKENS_BASE_URL=https://api.jup.ag/tokens/v2
JUPITER_API_KEY=
JUPITER_REQUEST_INTERVAL_MS=2000
JUPITER_CACHE_TTL_MS=30000
JUPITER_CACHE_MAX_ENTRIES=1000
JUPITER_SWAP_ENABLED=false
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_QUOTE_TIMEOUT_MS=5000
JUPITER_MAX_QUOTE_AGE_MS=15000
JUPITER_SWAP_REQUEST_INTERVAL_MS=2000
JUPITER_UNSIGNED_BUILD_ENABLED=false
JUPITER_RPC_SIMULATION_ENABLED=false
JUPITER_TAKER_PUBLIC_KEY=
JUPITER_MAX_SLIPPAGE_BPS=500
JUPITER_MAX_PRICE_IMPACT_BPS=500
JUPITER_MAX_FEE_BPS=200
RISK_MIN_LIQUIDITY_USD=40000
RISK_MAX_TOP_HOLDERS_PERCENTAGE=35
RISK_MAX_LIQUIDITY_DROP_PERCENTAGE=50
RISK_MAX_DATA_AGE_SECONDS=60
RISK_REQUIRE_HOLDER_DATA=true
RISK_REQUIRE_EXPLICIT_SUSPICIOUS_FLAG=true
RISK_POLICY_VERSION=solemn-week3-v1
RISK_ANALYSIS_CONCURRENCY=2
RISK_ANALYSIS_RETRY_LIMIT=3
RISK_REASSESS_INTERVAL_MS=60000
RISK_POLL_INTERVAL_MS=1000
RISK_HTTP_TIMEOUT_MS=8000
RISK_HTTP_MAX_ATTEMPTS=3
RISK_HTTP_RETRY_MS=1000
RISK_HTTP_MAX_BACKOFF_MS=60000
RISK_RPC_REQUEST_INTERVAL_MS=1000
RISK_JOB_LEASE_MS=300000
RISK_SHUTDOWN_TIMEOUT_MS=15000

# Week 4 research only. No individual-trade live adapter is installed.
# Enabling without a fixture file records NOT_READY decisions for eligible tokens.
STRATEGY_ENABLED=false
STRATEGY_ID=SOLEMN_LAUNCH_MOMENTUM_V1
STRATEGY_VERSION=1.0.0
MARKET_DATA_PROVIDER=FIXTURE
# Only false is supported; no paid trade subscription is implemented.
ENABLE_PAID_TRADE_STREAM=false
MARKET_DATA_MAX_TRACKED_TOKENS=10
MARKET_DATA_ALLOWED_LATENESS_MS=5000
STRATEGY_FIXTURE_PATH=
STRATEGY_POLL_INTERVAL_MS=30000
STRATEGY_MIN_POOL_AGE_MINUTES=2
STRATEGY_MAX_POOL_AGE_MINUTES=90
STRATEGY_MIN_LIQUIDITY_USD=40000
STRATEGY_MIN_VOLUME_ACCELERATION=2.0
STRATEGY_MIN_BUY_SELL_RATIO=1.5
STRATEGY_MIN_UNIQUE_BUYERS_5M=40
STRATEGY_BREAKOUT_LOOKBACK_CANDLES=3
STRATEGY_BREAKOUT_BUFFER_PERCENT=1.0
STRATEGY_MIN_PULLBACK_PERCENT=10.0
STRATEGY_MIN_INITIAL_SPIKE_PERCENT=5.0
STRATEGY_MAX_VOLATILITY_PERCENT=25.0
STRATEGY_PATTERN_MAX_AGE_SECONDS=600
STRATEGY_SIGNAL_COOLDOWN_SECONDS=300
STRATEGY_MAX_RISK_ASSESSMENT_AGE_SECONDS=120
STRATEGY_MAX_MARKET_DATA_AGE_SECONDS=30

# Week 5 durable PAPER accounts. No live market execution provider is installed.
PAPER_TRADING_ENABLED=false
# Worker replay requires both this opt-in and an explicit JSON replay path.
PAPER_ALLOW_FIXTURE_SIGNALS=false
PAPER_REPLAY_PATH=
# Empty derives a stable ID from the replay/configuration; never resets existing cash.
PAPER_PORTFOLIO_ID=
PAPER_PORTFOLIO_NAME=week5-replay
PAPER_MAX_POSITION_PERCENT=1.0
PAPER_MAX_OPEN_POSITIONS=3
PAPER_STOP_LOSS_PERCENT=25.0
PAPER_TAKE_PROFIT_1_PERCENT=60.0
PAPER_TAKE_PROFIT_1_SELL_FRACTION=33.3333
PAPER_TAKE_PROFIT_2_PERCENT=150.0
PAPER_TAKE_PROFIT_2_SELL_FRACTION=50.0
PAPER_TRAILING_STOP_PERCENT=30.0
PAPER_MAX_HOLDING_MINUTES=60
PAPER_MAX_DAILY_LOSS_PERCENT=3.0
PAPER_MAX_TOTAL_DRAWDOWN_PERCENT=10.0
# Hypothetical research costs, not current venue fees.
PAPER_BUY_FEE_PERCENT=1.0
PAPER_SELL_FEE_PERCENT=1.0
PAPER_BASELINE_SLIPPAGE_PERCENT=1.0
PAPER_MAX_LIQUIDITY_PARTICIPATION_PERCENT=1.0
PAPER_MIN_ORDER_USD=0.01
# Explicit simulation precision; does not assert an on-chain mint's decimals.
PAPER_QUANTITY_DECIMALS=9
PAPER_MAX_PRICE_AGE_SECONDS=15
PAPER_MAX_SIGNAL_AGE_SECONDS=60
PAPER_ENTRY_COOLDOWN_SECONDS=300

# Week 6 runs only through the explicit backtest CLI, never on worker startup.
# Configure per-run latency, dates, dataset and output using --config or CLI flags.
# Example: pnpm backtest --dataset fixtures --latency-ms 1000

# Week 8 forward paper trading. Use one explicit runtime path per worker.
OPERATIONS_HEALTH_CHECK_INTERVAL_SECONDS=10
OPERATIONS_OUTAGE_ALERT_SECONDS=15
OPERATIONS_MAX_QUEUE_UTILIZATION_PERCENT=80
FORWARD_PAPER_ENABLED=false
FORWARD_MARKET_DATA_MODE=REPLAY
FORWARD_ACCOUNT=week8
ENABLE_METERED_MARKET_DATA=false
FORWARD_MAX_TRACKED_TOKENS=10
FORWARD_MAX_MARKET_DATA_AGE_SECONDS=15
FORWARD_DAILY_EVENT_BUDGET=10000
FORWARD_EQUITY_SNAPSHOT_INTERVAL_SECONDS=60
