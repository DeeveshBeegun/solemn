{
  "name": "solemn",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Solemn \u2014 Automated Solana Meme Coin Trading System (paper-only foundation)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm build && tsx watch apps/worker/src/index.ts",
    "start": "node apps/worker/dist/index.js",
    "scanner:smoke": "pnpm build && node apps/worker/dist/scanner/smoke.js",
    "risk:assess": "pnpm build && node apps/worker/dist/analysis/assess.js",
    "build": "tsc -b",
    "typecheck": "pnpm build && tsc -p tsconfig.check.json --noEmit",
    "test": "pnpm build && vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "db:generate": "pnpm build && pnpm --filter @solemn/database db:generate",
    "db:migrate": "pnpm build && pnpm --filter @solemn/database db:migrate",
    "strategy:replay": "pnpm build && node apps/worker/dist/strategy/replayCli.js",
    "paper:replay": "pnpm build && node apps/worker/dist/portfolio/replayCli.js",
    "paper:inspect": "pnpm build && node apps/worker/dist/portfolio/adminCli.js inspect",
    "paper:reset": "pnpm build && node apps/worker/dist/portfolio/adminCli.js reset",
    "paper:halt": "pnpm build && node apps/worker/dist/portfolio/adminCli.js halt",
    "backtest": "pnpm build && node apps/worker/dist/backtesting/cli.js",
    "backtest:stress": "pnpm build && node apps/worker/dist/backtesting/stressCli.js",
    "paper:forward": "pnpm build && node apps/worker/dist/forward/cli.js run",
    "paper:status": "pnpm build && node apps/worker/dist/forward/cli.js status",
    "paper:positions": "pnpm build && node apps/worker/dist/forward/cli.js positions",
    "paper:performance": "pnpm build && node apps/worker/dist/forward/cli.js performance",
    "paper:pause": "pnpm build && node apps/worker/dist/forward/cli.js pause",
    "paper:resume": "pnpm build && node apps/worker/dist/forward/cli.js resume",
    "paper:forward-halt": "pnpm build && node apps/worker/dist/forward/cli.js halt",
    "paper:forward-reset": "pnpm build && node apps/worker/dist/forward/cli.js reset-halt",
    "paper:rearm-metered": "pnpm build && node apps/worker/dist/forward/cli.js rearm-metered",
    "analytics:summary": "pnpm build && node apps/worker/dist/analytics/cli.js summary",
    "analytics:trades": "pnpm build && node apps/worker/dist/analytics/cli.js trades",
    "analytics:signals": "pnpm build && node apps/worker/dist/analytics/cli.js signals",
    "analytics:compare": "pnpm build && node apps/worker/dist/analytics/cli.js compare",
    "analytics:report": "pnpm build && node apps/worker/dist/analytics/cli.js report",
    "analytics:register": "pnpm build && node apps/worker/dist/analytics/cli.js register",
    "swap:quote": "pnpm build && node apps/worker/dist/execution/jupiter/cli.js quote",
    "swap:inspect": "pnpm build && node apps/worker/dist/execution/jupiter/cli.js inspect",
    "swap:simulate": "pnpm build && node apps/worker/dist/execution/jupiter/cli.js simulate",
    "swap:readiness": "pnpm build && node apps/worker/dist/execution/jupiter/cli.js readiness",
    "solemn:status": "pnpm build && node apps/worker/dist/operations/cli.js status",
    "solemn:health": "pnpm build && node apps/worker/dist/operations/cli.js health",
    "solemn:pause": "pnpm build && node apps/worker/dist/operations/cli.js pause",
    "solemn:halt": "pnpm build && node apps/worker/dist/operations/cli.js halt",
    "solemn:resume": "pnpm build && node apps/worker/dist/operations/cli.js resume",
    "solemn:reset-halt": "pnpm build && node apps/worker/dist/operations/cli.js reset-halt",
    "solemn:reconcile": "pnpm build && node apps/worker/dist/operations/cli.js reconcile",
    "solemn:incidents": "pnpm build && node apps/worker/dist/operations/cli.js incidents",
    "release:verify": "node scripts/release-verify.mjs",
    "release:smoke": "pnpm build && node scripts/release-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
