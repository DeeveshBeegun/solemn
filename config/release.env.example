# Copy to an ignored .env in the deployment checkout and replace placeholders.
NODE_ENV=production
LOG_LEVEL=info
POSTGRES_USER=solemn
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=solemn
POSTGRES_PORT=55432
DATABASE_URL=postgresql://solemn:replace-with-local-password@127.0.0.1:55432/solemn
# Compose also interpolates the disposable test profile when it is inactive.
TEST_POSTGRES_PASSWORD=replace-with-separate-test-password
TEST_DATABASE_URL=postgresql://solemn_test:replace-with-separate-test-password@127.0.0.1:5433/solemn_test
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
EXECUTION_ADAPTER=PAPER
INITIAL_PAPER_BALANCE_USD=100
SCANNER_ENABLED=false
TOKEN_RISK_ANALYSIS_ENABLED=false
STRATEGY_ENABLED=false
PAPER_TRADING_ENABLED=false
FORWARD_PAPER_ENABLED=false
FORWARD_MARKET_DATA_MODE=REPLAY
FORWARD_ACCOUNT=release-paper
ENABLE_PAID_TRADE_STREAM=false
ENABLE_METERED_MARKET_DATA=false
JUPITER_SWAP_ENABLED=false
JUPITER_UNSIGNED_BUILD_ENABLED=false
JUPITER_RPC_SIMULATION_ENABLED=false
